                <div class="text-3xl mb-2">⚡🚀🔥</div>
                <p id="previewGameName" class="text-white font-bold text-sm">Free Fire / PUBG 3D (Samsung NPU Powered)</p>
                <p class="text-[10px] text-gray-400">Status: Compiled in 0.01ms via Stream-Speed Quantum Server. Ready to play!</p>
                <div class="bg-purple-950/40 p-3 rounded-xl border border-purple-500/40 mt-3 text-xs text-purple-200">
                    🎮 Stream Controls: Ultra-low latency response enabled across Samsung & Global servers!
                </div>
            </div>
            <button onclick="closePreviewModal()" class="w-full btn-nexus py-2.5 rounded-xl text-xs font-bold text-white shadow">Close Sandbox</button>
        </div>
    </div>

    <script>
        let scene, camera, renderer, particles;
        let currentCredits = 750;

        function initThreeJSQuantumUniverse() {
            const container = document.getElementById('threeCanvasContainer');
            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 1, 3000);
            camera.position.z = 1200;
            renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(window.devicePixelRatio);
            container.appendChild(renderer.domElement);

            const particleCount = 5000;
            const geometry = new THREE.BufferGeometry();
            const positions = new Float32Array(particleCount * 3);
            const colors = new Float32Array(particleCount * 3);
            const color = new THREE.Color();

            for (let i = 0; i < particleCount * 3; i += 3) {
                positions[i] = (Math.random() - 0.5) * 3000;
                positions[i + 1] = (Math.random() - 0.5) * 3000;
                positions[i + 2] = (Math.random() - 0.5) * 3000;
                color.setHex(Math.random() > 0.4 ? (Math.random() > 0.5 ? 0xa855f7 : 0xec4899) : 0x06b6d4);
                colors[i] = color.r; colors[i + 1] = color.g; colors[i + 2] = color.b;
            }
            geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
            geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
            const material = new THREE.PointsMaterial({ size: 4, vertexColors: true, transparent: true, opacity: 0.95, blending: THREE.AdditiveBlending });
            particles = new THREE.Points(geometry, material);
            scene.add(particles);

            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
            });
            animateThreeJS();
        }

        function animateThreeJS() {
            requestAnimationFrame(animateThreeJS);
            particles.rotation.x += 0.0004;
            particles.rotation.y += 0.0008;
            renderer.render(scene, camera);
        }

        function initializeSovereign12Core() {
            console.log("[SpheroNav Sovereign 12.0]: Stream-Speed Server & Samsung AI Core Initialized.");
            initThreeJSQuantumUniverse();
            startAiStreamSimulator();
        }

        const streamAiLogs = [
            "⚡ [Stream Server] 🚀: 0.01ms ultra-fast packet delivery active for Babu Islam! 😂🔥",
            "🔋 [Samsung Galaxy AI] 💎: Neural processing unit computing high-end game graphics! 🌀✨",
            "📱 [One UI Engine] ⚡: Ultra-fast fluid rendering & transition effects active! 🌟🚀",
            "🛡️ [Samsung Knox & Security] 🔒: Enterprise hardware-level encryption verified! 🎯🔥",
            "👑 [Stream Overlord] 🔥: Free Fire, PUBG, DLS and Ludo builders running at maximum speed! ⚡👑"
        ];
        let streamIndex = 0;

        function startAiStreamSimulator() {
            const msgBox = document.getElementById('aiLiveMessageBox');
            setInterval(() => {
                if(msgBox) {
                    const msg = streamAiLogs[streamIndex];
                    const div = document.createElement('div');
                    div.className = "border-l-2 border-purple-500 pl-2.5 py-1 text-purple-200";
                    div.innerText = msg;
                    msgBox.appendChild(div);
                    msgBox.scrollTop = msgBox.scrollHeight;
                    streamIndex = (streamIndex + 1) % streamAiLogs.length;
                }
            }, 3000);
        }

        function toggleRightSlideDrawer() { document.getElementById('rightSlideDrawer').classList.toggle('translate-x-full'); }
        function toggleEngineDropdown() { document.getElementById('engineDropdownMenu').classList.toggle('hidden'); }
        function selectEngine(name) { document.getElementById('currentEngineText').innerText = name; document.getElementById('engineDropdownMenu').classList.add('hidden'); }
        function setInteractionMode(mode) {
            ['stream', 'samsung'].forEach(m => {
                const btn = document.getElementById('modeBtn-' + m);
                if(btn) btn.className = m === mode ? "px-2.5 py-1 rounded-lg bg-purple-600/60 text-white font-bold transition shadow" : "px-2.5 py-1 rounded-lg text-gray-400 hover:text-white transition";
            });
        }
        function handleGatewayToggle(name, status) {
            console.log(`[Gateway API]: ${name} is ${status ? "Online" : "Paused"}`);
            triggerFemaleVoice(`${name} is now ${status ? "Online" : "Paused"}`);
        }
        function toggleVoiceCommandInput() {
            const input = document.getElementById('masterPromptInput');
            input.placeholder = "Listening via Stream Mic...";
            setTimeout(() => {
                input.value = "স্যামসাং এআই এবং স্ট্রিম সার্ভার স্পিড ব্যবহার করে ফ্রি ফায়ার গেম তৈরি করে দাও";
                input.placeholder = "যেমন: 'স্যামসাং এআই এবং স্ট্রিম সার্ভার...'";
                alert("🎙️ [Voice Command Recognized]: 'স্যামসাং এআই এবং স্ট্রিম সার্ভার স্পিড ব্যবহার করে ফ্রি ফায়ার গেম তৈরি করে দাও'");
            }, 2500);
        }
        function openCreditWalletModal() { document.getElementById('creditWalletModal').style.display = 'flex'; }
        function closeCreditWalletModal() { document.getElementById('creditWalletModal').style.display = 'none'; }
        function openMenuModal(title) {
            document.getElementById('modalTitle').innerText = title;
            document.getElementById('modalDesc').innerText = `[${title}]: Verified under Babu's Stream-Speed & Samsung Core.`;
            document.getElementById('menuItemModal').style.display = 'flex';
        }
        function closeMenuModal() { document.getElementById('menuItemModal').style.display = 'none'; }
        function openAiLiveStreamModal() { document.getElementById('aiLiveStreamModal').style.display = 'flex'; }
        function closeAiLiveStreamModal() { document.getElementById('aiLiveStreamModal').style.display = 'none'; }
        function openPreviewModal() { document.getElementById('previewModal').style.display = 'flex'; }
        function closePreviewModal() { document.getElementById('previewModal').style.display = 'none'; }
        
        function buyCredits(pack, amount, price) {
            alert(`[bKash Secure Gateway]: Request received for ${pack} (${amount} - ${price}). Send payment to 01758889800. Credits added instantly!`);
            currentCredits += parseInt(amount);
            document.getElementById('userCreditBalance').innerText = currentCredits + " Credits";
            document.getElementById('modalCreditDisplay').innerText = currentCredits + " Credits";
        }

        function triggerFemaleVoice(text) {
            if('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.pitch = 1.2; utterance.rate = 1.0;
                window.speechSynthesis.speak(utterance);
            }
        }
        function triggerStreamSpeaker() {
            triggerFemaleVoice(streamAiLogs[Math.floor(Math.random() * streamAiLogs.length)]);
        }
        function copyOutputContent() {
            navigator.clipboard.writeText(document.getElementById('outputText').innerText);
            alert("📋 Content copied to clipboard successfully!");
        }

        function executeStreamServerBuilder() {
            const prompt = document.getElementById('masterPromptInput').value.trim() || "Free Fire / PUBG 3D Game";
            if(currentCredits < 50) {
                alert("❌ Not enough credits! Please top up via bKash to build games.");
                openCreditWalletModal();
                return;
            }
            currentCredits -= 50;
            document.getElementById('userCreditBalance').innerText = currentCredits + " Credits";
            document.getElementById('modalCreditDisplay').innerText = currentCredits + " Credits";

            const outputText = document.getElementById('outputText');
            outputText.innerHTML = `<span class="text-purple-400">⚡ Stream-Speed Server (0.01ms) & Samsung Galaxy AI building: <strong>"${prompt}"</strong>...</span>`;
            setTimeout(() => {
                outputText.innerHTML = `✅ Successfully built: <strong>"${prompt}"</strong> using Stream-Speed Server and Samsung AI Engine! APK & source code ready.`;
                document.getElementById('downloadActionContainer').classList.remove('hidden');
                document.getElementById('previewGameName').innerText = prompt;
                triggerFemaleVoice("Game generated successfully with stream-speed and Samsung AI.");
            }, 1800);
            document.getElementById('masterPromptInput').value = "";
        }

        function buildStreamGame(gameName, cost) {
            if(currentCredits < cost) {
                alert(`❌ You need ${cost} credits to build ${gameName}. Please top up via bKash!`);
                openCreditWalletModal();
                return;
            }
            currentCredits -= cost;
            document.getElementById('userCreditBalance').innerText = currentCredits + " Credits";
            document.getElementById('modalCreditDisplay').innerText = currentCredits + " Credits";

            const outputText = document.getElementById('outputText');
            outputText.innerHTML = `<span class="text-purple-400">⚡ Building <strong>"${gameName}"</strong> at 0.01ms stream speed...</span>`;
            setTimeout(() => {
                outputText.innerHTML = `✅ Successfully built <strong>"${gameName}"</strong>! Live sandbox and APK download active.`;
                document.getElementById('downloadActionContainer').classList.remove('hidden');
                document.getElementById('previewGameName').innerText = gameName;
                triggerFemaleVoice(`${gameName} built successfully with stream-speed server.`);
            }, 1500);
        }

        function downloadAppPackage(type) {
            if(type === 'apk') {
                alert("📥 [Stream APK Compiler]: Compiling native .apk package via Quantum Server. Download starting instantly...");
            } else {
                alert("📦 [Source Code Exporter]: Downloading full optimized source code zip package...");
            }
        }
        function switchWorkspaceTab(tab) {
            ['home', 'store', 'sandbox'].forEach(t => {
                const el = document.getElementById('nav' + t.charAt(0).toUpperCase() + t.slice(1));
                if(el) { el.classList.remove('text-purple-400'); el.classList.add('text-gray-400'); }
            });
            const activeEl = document.getElementById('nav' + tab.charAt(0).toUpperCase() + tab.slice(1));
            if(activeEl) { activeEl.classList.remove('text-gray-400'); activeEl.classList.add('text-purple-400'); }
            if(tab === 'store') openCreditWalletModal();
            if(tab === 'sandbox') openPreviewModal();
            window.scrollTo({top: 0, behavior: 'smooth'});
        }
    </script>
</body>
</html>
